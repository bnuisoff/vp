<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Lisa seos | Sofia Jürgenson, veebiprogrammeerimine</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">

	<div class="topbar">
		<%- include('partials/nav', { active: 'eestifilm' }) %>
	</div>

	<a class="back" href="/eestifilm">← Eesti filmi avaleht</a>
	<h1>Lisa seos</h1>

	<form class="card form" method="POST">
		<div class="field">
			<label for="personInput">Isik</label>
			<select id="personInput" name="personInput">
				<option value="" <%= personInput ? '' : 'selected' %> disabled>Vali isik ...</option>
				<% persons.forEach(p => { %>
					<option value="<%= p.id %>" <%= personInput == p.id ? 'selected' : '' %>>
						<%= p.first_name %> <%= p.last_name %>
					</option>
				<% }); %>
			</select>
		</div>

		<div class="field">
			<label for="movieInput">Film</label>
			<select id="movieInput" name="movieInput">
				<option value="" <%= movieInput ? '' : 'selected' %> disabled>Vali film ...</option>
				<% movies.forEach(m => { %>
					<option value="<%= m.id %>" <%= movieInput == m.id ? 'selected' : '' %>><%= m.title %></option>
				<% }); %>
			</select>
		</div>

		<div class="field">
			<label for="professionInput">Amet</label>
			<select id="professionInput" name="professionInput">
				<option value="" <%= professionInput ? '' : 'selected' %> disabled>Vali amet ...</option>
				<% professions.forEach(a => { %>
					<option value="<%= a.id %>" <%= professionInput == a.id ? 'selected' : '' %>><%= a.title %></option>
				<% }); %>
			</select>
		</div>

		<div class="field">
			<label for="characterInput">Tegelase nimi (pole kohustuslik)</label>
			<input type="text" id="characterInput" name="characterInput" maxlength="100" value="<%= characterInput %>">
		</div>

		<input class="btn btn-pink" type="submit" value="Salvesta">
	</form>
	<p class="notice"><%= notice %></p>

	<div class="btn-row">
		<a class="btn btn-purple" href="/eestifilm/eestifilmiseosed">Vaata seoseid</a>
	</div>
</div>
</body>
</html>
