<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Eesti filmi inimesed</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">

	<div class="topbar">
		<%- include('partials/nav', { active: 'eestifilm' }) %>
	</div>

	<a class="back" href="/eestifilm">← Eesti filmi avaleht</a>
	<h1>Eesti filmiga seotud inimesed</h1>

	<div class="card">
		<ol class="people">
			<% personList.forEach(function(person) { %>
				<li><%= person.first_name %> <%= person.last_name %>, sündinud <%= person.born.toLocaleDateString('et-EE') %></li>
			<% }); %>
		</ol>
	</div>
</div>
</body>
</html>
