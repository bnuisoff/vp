<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Lisa Eesti film</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">

	<div class="topbar">
		<%- include('partials/nav', { active: 'eestifilm' }) %>
	</div>

	<a class="back" href="/eestifilm">← Eesti filmi avaleht</a>
	<h1>Lisa Eesti film</h1>
	<form class="card form" method="POST">
		<div class="field">
			<label for="titleInput">Filmi pealkiri</label>
			<input type="text" id="titleInput" name="titleInput" maxlength="100" value="<%= titleInput %>" required>
		</div>
		<div class="field">
			<label for="releaseYearInput">Valmimisaasta</label>
			<input type="number" id="releaseYearInput" name="releaseYearInput" value="<%= releaseYearInput %>" required>
		</div>
		<div class="field">
			<label for="durationInput">Kestus (minutites)</label>
			<input type="number" id="durationInput" name="durationInput" value="<%= durationInput %>" required>
		</div>
		<div class="field">
			<label for="descriptionInput">Kirjeldus</label>
			<textarea id="descriptionInput" name="descriptionInput" rows="5" maxlength="1000"><%= descriptionInput %></textarea>
		</div>
		<input class="btn btn-pink" type="submit" value="Salvesta">
	</form>
	<p class="notice"><%= notice %></p>
</div>
</body>
</html>
