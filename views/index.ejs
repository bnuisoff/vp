<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Sofia Jürgenson, veebiprogrammeerimine</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">

	<div class="topbar">
		<%- include('partials/nav', { active: 'avaleht' }) %>
		<span class="clock" id="kuupaev"><%= day %>, <%= date %>, kell <%= time %></span>
	</div>

	<img class="banner" src="/pic/veebiprogrammeerimine_2026_ID.png" alt="Veebiprogrammeerimine bänner">
	

	<% if (photos.length > 0) { %>
<div class="strip">
    <button type="button" class="strip-btn" onclick="document.getElementById('stripList').scrollBy({ left: -300, behavior: 'smooth' })">‹</button>
    <div class="strip-list" id="stripList">
        <% photos.forEach(photo => { %>
            <a href="/galleryphotos">
                <img src="/gallery/thumbs/<%= photo.filename %>" alt="<%= photo.alttext %>" title="<%= photo.alttext %>">
            </a>
        <% }); %>
    </div>
    <button type="button" class="strip-btn" onclick="document.getElementById('stripList').scrollBy({ left: 300, behavior: 'smooth' })">›</button>
</div>
<% } %>
<% if (photo) { %>
    <h2>Uusim avalik foto</h2>
    <img class="photo" src="/gallery/normal/<%= photo.filename %>" alt="<%= photo.alttext || 'Uusim avalik foto' %>">
<% } %>


	<h1>Sofia Jürgenson, veebiprogrammeerimise kursus</h1>
	<p>See leht on loodud veebiprogrammeerimise kursusel <a href="https://www.tlu.ee">Tallinna Ülikoolis</a> ning ei sisalda tõsiseltvõetavat sisu</p>

	<img class="photo" src="/pic/soovad.gif" alt="nomnom">

	<div class="btn-row">
		<form action="/visits/regvisit" method="GET">
			<input class="btn btn-pink" type="submit" value="Registreeri külastus">
		</form>
		<form action="/visits" method="GET">
			<input class="btn btn-purple" type="submit" value="Vaata viimast külastust">
		</form>
	</div>
</div>
</body>
</html>
