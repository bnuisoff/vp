<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Tere tulemast!</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">
	<div class="topbar">
		<%- include('partials/nav', { active: 'konto' }) %>
	</div>

	<h1>Tere tulemast!</h1>

	<div class="card">
		<p>Sisselogimine õnnestus.</p>
	</div>
	<% if (latestNews) { %>
	<div class="card news-item">
		<h2>Värskeim uudis: <%= latestNews.news_title %></h2>
		<p class="news-meta">Lisatud <%= latestNews.created.toLocaleDateString('et-EE') %></p>
		<% if (latestNews.filename) { %>
			<img src="/news/normal/<%= latestNews.filename %>" alt="<%= latestNews.alttext %>">
		<% } %>
		<p><%= latestNews.news_text %></p>
	</div>
	<% } %>
	<div class="btn-row">
		<a class="btn btn-purple" href="/">Avalehele</a>
	</div>
</div>
</body>
</html>