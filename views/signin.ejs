<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Logi sisse</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">
	<div class="topbar">
		<%- include('partials/nav', { active: 'konto' }) %>
	</div>

	<h1>Logi sisse</h1>

	<div class="card form">
		<form method="POST">
			<div class="field">
				<label for="emailInput">E-mail</label>
				<input type="email" id="emailInput" name="emailInput" placeholder="Sinu e-mail ...." value="<%= formData.email || '' %>" required>
			</div>

			<div class="field">
				<label for="passwordInput">Salasõna</label>
				<input type="password" id="passwordInput" name="passwordInput" required>
			</div>

			<input class="btn btn-pink" type="submit" value="Logi sisse">
		</form>

		<p class="notice"><%= notice %></p>
		<p>Kontot veel pole? <a href="/signup">Loo kasutajakonto</a></p>
	</div>
</div>
</body>
</html>