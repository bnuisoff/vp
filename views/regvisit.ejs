<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="utf-8">
    <title>Külastuse registreerimine</title>
</head>
<style>
    body { background-color: #a2c4d4; padding: 8px; }
</style>
<body>
    <h1>Külastuse registreerimine</h1>
    <form action="/regvisit" method="POST">
        <label for="inputName">Sisesta oma nimi:</label>
        <input type="text" id="inputName" name="inputName" placeholder="Sinu nimi" required>
        <br>
        <input type="submit" value="Salvesta">
    </form>
    <p><%= message %></p>
    <p><a href="/">Tagasi avalehele</a> | <a href="/visitlog">Viimane külastus</a></p>
</body>
</html>