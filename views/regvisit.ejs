<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Külastuse registreerimine</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">

	<div class="topbar">
		<%- include('partials/nav', { active: '' }) %>
	</div>

	<h1>Külastuse registreerimine</h1>

	<form class="card form" action="/visits/regvisit" method="POST">
		<div class="field">
			<label for="inputName">Sisesta oma nimi</label>
			<input type="text" id="inputName" name="inputName" placeholder="Sinu nimi" required>
		</div>
		<input class="btn btn-pink" type="submit" value="Salvesta">
	</form>
	<p class="notice"><%= message %></p>

	<div class="btn-row">
		<a class="btn btn-purple" href="/visits">Viimane külastus</a>
		<a class="btn btn-green" href="/">Tagasi avalehele</a>
	</div>
</div>
</body>
</html>
