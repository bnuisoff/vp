<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Eesti filmide seosed | Sofia Jürgenson, veebiprogrammeerimine</title>
	<link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">

	<div class="topbar">
		<%- include('partials/nav', { active: 'eestifilm' }) %>
	</div>

	<a class="back" href="/eestifilm">← Eesti filmi avaleht</a>
	<h1>Seosed</h1>

	<% if (relationList.length === 0) { %>
		<div class="card"><p>Seoseid pole veel lisatud.</p></div>
	<% } else { %>
		<div class="card table-wrap">
			<table class="table">
				<tr><th>Film</th><th>Isik</th><th>Amet</th><th>Tegelane</th></tr>
				<% relationList.forEach(r => { %>
					<tr>
						<td><%= r.movie_title %></td>
						<td><%= r.first_name %> <%= r.last_name %></td>
						<td><%= r.profession_title %></td>
						<td><%= r.character_name || '' %></td>
					</tr>
				<% }); %>
			</table>
		</div>
	<% } %>

	<div class="btn-row">
		<a class="btn btn-pink" href="/eestifilm/eestifilmiseosed_lisa">Lisa seos</a>
	</div>
</div>
</body>
</html>
