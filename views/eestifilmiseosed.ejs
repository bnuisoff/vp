<h1>Seosed</h1>

<head>
    <meta charset="utf-8">
    <title> Sofia Jürgenson, veebiprogrammeerimine</title>
    <style>
       body { background-color: #a2c4d4; padding: 8px; }
    </style>
</head>

<% if (relationList.length === 0) { %>
    <p>Seoseid pole veel lisatud.</p>
<% } else { %>
    <table>
        <tr><th>Film</th><th>Isik</th><th>Amet</th><th>Tegelane</th></tr>
        <% relationList.forEach(r => { %>
            <tr>
                <td><%= r.movie_title %></td>
                <td><%= r.first_name %> <%= r.last_name %></td>
                <td><%= r.profession_title %></td>
                <td><%= r.character_name || '' %></td>
            </tr>
        <% }); %>
    </table>
<% } %>

<p><a href="/eestifilm/eestifilmiseosed_lisa">Lisa seos</a> | <a href="/eestifilm">Tagasi</a></p>